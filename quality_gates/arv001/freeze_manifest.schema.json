{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arvectum.com/schemas/arv001/freeze_manifest.schema.json",
  "title": "ARV-001 golden report freeze manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "status",
    "policy_id",
    "policy_version",
    "policy_sha256",
    "case_ref",
    "producer_mode",
    "review_sha256",
    "evaluation_sha256",
    "artifacts",
    "reviewer_subjects",
    "adjudicator_subject",
    "approval_id",
    "frozen_at",
    "verdict",
    "release_allowed",
    "evidence_class",
    "source_graph_mutation",
    "external_execution"
  ],
  "properties": {
    "schema_version": {"const": "arv001-freeze-manifest-v1"},
    "task_id": {"const": "ARV-001"},
    "status": {"const": "FROZEN"},
    "policy_id": {"const": "arv001-golden-report-quality-gate"},
    "policy_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "policy_sha256": {"$ref": "#/$defs/sha256"},
    "case_ref": {"type": "string", "pattern": "^[A-Za-z0-9._-]{3,80}$"},
    "producer_mode": {"enum": ["frozen_r9", "production_llm_r10_1"]},
    "review_sha256": {"$ref": "#/$defs/sha256"},
    "evaluation_sha256": {"$ref": "#/$defs/sha256"},
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_bundle_sha256", "canonical_output_sha256", "report_sha256"],
      "properties": {
        "source_bundle_sha256": {"$ref": "#/$defs/sha256"},
        "canonical_output_sha256": {"$ref": "#/$defs/sha256"},
        "report_sha256": {"$ref": "#/$defs/sha256"},
        "source_graph_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "reviewer_subjects": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[A-Za-z0-9._-]{2,64}$"}
    },
    "adjudicator_subject": {
      "type": ["string", "null"],
      "pattern": "^[A-Za-z0-9._-]{2,64}$"
    },
    "approval_id": {"type": "string", "pattern": "^[A-Za-z0-9._-]{3,100}$"},
    "frozen_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "verdict": {"const": "PASS"},
    "release_allowed": {"const": true},
    "evidence_class": {"const": "real"},
    "source_graph_mutation": {"const": false},
    "external_execution": {"const": false}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
