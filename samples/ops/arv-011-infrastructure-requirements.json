  "security_requirements": [
    {
      "id": "SEC-01",
      "requirement": "TLS termination for all public HTTP traffic",
      "classification": "required_before_production",
      "rationale": "No encryption currently; basic auth credentials transmitted in plaintext"
    },
    {
      "id": "SEC-02",
      "requirement": "PostgreSQL not publicly accessible",
      "classification": "required_before_production",
      "rationale": "Currently published on 5432:5432 with default credentials"
    },
    {
      "id": "SEC-03",
      "requirement": "Protected operator access",
      "classification": "required_for_pilot",
