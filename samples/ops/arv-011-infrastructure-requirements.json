      "rationale": ".env.local convention exists but no enforcement"
    },
    {
      "id": "SEC-05",
      "requirement": "Production credentials different from defaults",
      "classification": "required_before_production",
      "rationale": "CHANGE_ME values must never reach production"
    },
    {
      "id": "SEC-06",
      "requirement": "Secret rotation process",
      "classification": "recommended_later",
      "rationale": "No rotation mechanism documented"
    },
    {
      "id": "SEC-07",
      "requirement": "Off-device backup with verified restore",
      "classification": "required_before_production",
      "rationale": "No backup infrastructure exists"
    },
    {
      "id": "SEC-08",
      "requirement": "Audit logs",
      "classification": "required_before_production",
      "rationale": "No audit trail for operations"
    },
    {
      "id": "SEC-09",
      "requirement": "Rate limiting",
      "classification": "required_before_production",
      "rationale": "API is unprotected against abuse"
    },
    {
      "id": "SEC-10",
      "requirement": "Allowed hosts validation",
      "classification": "required_for_pilot",
      "rationale": "TrustedHostMiddleware is configured but empty by default"
    },
    {
      "id": "SEC-11",
      "requirement": "CORS restriction",
      "classification": "required_before_production",
      "rationale": "CORS middleware is configured but empty by default"
    },
    {
      "id": "SEC-12",
      "requirement": "Safe proxy headers handling",
      "classification": "required_for_pilot",
      "rationale": "--proxy-headers is set but no reverse proxy validates forwarded headers"
    },
    {
      "id": "SEC-13",
      "requirement": "Minimized public port exposure",
      "classification": "required_before_production",
      "rationale": "Only port 8000 (with TLS) should be public"
    },
    {
      "id": "SEC-14",
      "requirement": "Controlled egress to EIS and LLM providers",
      "classification": "required_before_production",
      "rationale": "No controlled egress point for Russian endpoints"
    },
    {
      "id": "SEC-15",
      "requirement": "Raw procurement/customer document protection",
      "classification": "required_for_pilot",
      "rationale": "Documents stored on SSD without encryption at rest"
    },
    {
      "id": "SEC-16",
      "requirement": "Customer data isolation (tenant)",
      "classification": "required_for_pilot",
      "rationale": "Database has tenant isolation via registry_number/customer_inn but no hard tenant boundary"
    },
    {
      "id": "SEC-17",
      "requirement": "Data localization in Russia (where applicable)",
      "classification": "requires_legal_validation",
      "rationale": "EIS data may require Russian hosting; legal classification needed"
