{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "report_id",
    "version",
    "benchmark_id",
    "benchmark_version",
    "status",
    "accuracy_claim_status",
    "profile_count",
    "item_count",
    "positive_count",
    "hard_negative_count",
    "split_counts",
    "source_format_counts",
    "pack_root_count",
    "pack_roots_generated_and_verified_at_runtime",
    "metrics",
    "slice_metrics",
    "gates",
    "acceptance",
    "limitations",
    "production_accuracy_claims_allowed",
    "independent_acceptance_required",
    "shadow_runtime_promotion_allowed",
    "runtime_import"
  ],
  "properties": {
    "report_id": {"const": "ARV-067H-TRUTH-PACK-RELEASE-REPORT"},
    "version": {"type": "string"},
    "benchmark_id": {"type": "string"},
    "benchmark_version": {"type": "string"},
    "status": {"enum": ["RELEASE_BLOCKED", "RELEASE_ELIGIBLE"]},
    "accuracy_claim_status": {"type": "string"},
    "profile_count": {"type": "integer", "minimum": 1},
    "item_count": {"type": "integer", "minimum": 1},
    "positive_count": {"type": "integer", "minimum": 0},
    "hard_negative_count": {"type": "integer", "minimum": 0},
    "split_counts": {"type": "object"},
    "source_format_counts": {"type": "object"},
    "pack_root_count": {"type": "integer", "minimum": 1},
    "pack_roots_generated_and_verified_at_runtime": {"const": true},
    "metrics": {"type": "object"},
    "slice_metrics": {"type": "object"},
    "gates": {"type": "object"},
    "acceptance": {"type": "object"},
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "production_accuracy_claims_allowed": {"const": false},
    "independent_acceptance_required": {"const": true},
    "shadow_runtime_promotion_allowed": {"const": false},
    "runtime_import": {"const": false}
  }
}
