{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["fragment_id", "version", "claims"],
  "properties": {
    "fragment_id": {"type": "string"},
    "version": {"type": "string"},
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["claim_id", "logical_claim_id", "claim_version", "claim_type", "subject", "predicate", "object_value", "object_ref", "assertion_hash", "source_links", "confidence", "review", "review_required", "production_ready", "conflict_group_ids", "supersedes_claim_id", "active", "sensitive_content_stored", "protected_full_text_stored"],
        "properties": {
          "claim_id": {"type": "string"},
          "logical_claim_id": {"type": "string"},
          "claim_version": {"type": "integer", "minimum": 1},
          "claim_type": {"enum": ["category", "alias", "attribute", "allowed_value", "relation", "normative_requirement"]},
          "subject": {"type": "object", "additionalProperties": false, "required": ["kind", "id"], "properties": {"kind": {"type": "string"}, "id": {"type": "string"}}},
          "predicate": {"type": "string"},
          "object_value": {},
          "object_ref": {"type": ["object", "null"]},
          "assertion_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "source_links": {"type": "array", "minItems": 1, "items": {"type": "object"}},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "review": {"type": "object"},
          "review_required": {"type": "boolean"},
          "production_ready": {"type": "boolean"},
          "conflict_group_ids": {"type": "array", "items": {"type": "string"}},
          "supersedes_claim_id": {"type": ["string", "null"]},
          "active": {"type": "boolean"},
          "sensitive_content_stored": {"const": false},
          "protected_full_text_stored": {"const": false}
        }
      }
    }
  }
}
