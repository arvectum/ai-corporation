{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arvectum.com/schemas/categories/electrical/component_role_registry.schema.json",
  "title": "ARV-067C electrical component role registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "registry_id",
    "version",
    "status",
    "components"
  ],
  "properties": {
    "registry_id": {
      "const": "ARV-067C-ELECTRICAL-COMPONENT-ROLES"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "status": {
      "const": "research_asset"
    },
    "components": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title_ru",
          "lifecycle_status",
          "aliases",
          "host_category_ids",
          "attribute_refs",
          "provenance"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^electrical\\.component\\.[a-z][a-z0-9_]*$"
          },
          "title_ru": {
            "type": "string",
            "minLength": 8
          },
          "lifecycle_status": {
            "enum": [
              "provisional",
              "source_verified",
              "deprecated"
            ]
          },
          "aliases": {
            "type": "array",
            "minItems": 2,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 3
            }
          },
          "host_category_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^electrical\\."
            }
          },
          "attribute_refs": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            }
          },
          "provenance": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source_asset",
              "source_kind",
              "review_status",
              "rationale_ru"
            ],
            "properties": {
              "source_asset": {
                "type": "string",
                "minLength": 5
              },
              "source_kind": {
                "enum": [
                  "detailed_profile_semantics",
                  "category_attribute_contract"
                ]
              },
              "review_status": {
                "enum": [
                  "machine_extracted",
                  "source_verified"
                ]
              },
              "rationale_ru": {
                "type": "string",
                "minLength": 80
              }
            }
          }
        }
      }
    }
  }
}
