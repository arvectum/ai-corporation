{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "benchmark_id",
    "version",
    "status",
    "locale",
    "runtime_import",
    "ontology_registry_id",
    "ontology_version",
    "product_catalog_registry_id",
    "provenance_registry_id",
    "seed_contract_file",
    "acceptance_file",
    "contract_fixture_file",
    "profile_count",
    "items_per_profile",
    "positive_items_per_profile",
    "hard_negative_items_per_profile",
    "total_items",
    "split_policy",
    "outcome_targets_per_profile",
    "source_formats",
    "noise_modes",
    "required_slices",
    "metrics",
    "release_gates",
    "truth_item_contract",
    "acceptance_policy",
    "governance"
  ],
  "properties": {
    "benchmark_id": {"const": "ARV-067H-ELECTRICAL-TRUTH-PACK-BENCHMARK"},
    "version": {"type": "string"},
    "status": {"type": "string"},
    "locale": {"type": "string"},
    "runtime_import": {"const": false},
    "ontology_registry_id": {"type": "string"},
    "ontology_version": {"type": "string"},
    "product_catalog_registry_id": {"type": "string"},
    "provenance_registry_id": {"type": "string"},
    "seed_contract_file": {"type": "string"},
    "acceptance_file": {"type": "string"},
    "contract_fixture_file": {"type": "string"},
    "profile_count": {"type": "integer", "minimum": 1},
    "items_per_profile": {"type": "integer", "minimum": 150},
    "positive_items_per_profile": {"type": "integer", "minimum": 100},
    "hard_negative_items_per_profile": {"type": "integer", "minimum": 50, "maximum": 100},
    "total_items": {"type": "integer", "minimum": 1},
    "split_policy": {"type": "object"},
    "outcome_targets_per_profile": {"type": "object"},
    "source_formats": {"type": "array", "minItems": 4, "items": {"type": "string"}},
    "noise_modes": {"type": "array", "minItems": 4, "items": {"type": "string"}},
    "required_slices": {"type": "array", "minItems": 3, "items": {"type": "string"}},
    "metrics": {"type": "array", "minItems": 8, "items": {"type": "string"}},
    "release_gates": {"type": "object"},
    "truth_item_contract": {"type": "object"},
    "acceptance_policy": {"type": "object"},
    "governance": {"type": "object"}
  }
}
