    "version",
    "status",
    "locale",
    "runtime_import",
    "source_registry_ref",
    "document_edition_file",
    "requirement_files",
    "fixture_file",
    "counts",
    "applicability_priorities",
    "constraint_types",
    "review_statuses",
    "requirement_statuses",
    "conflict_policy",
    "decision_policy",
    "governance"
