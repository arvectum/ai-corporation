    "fixture_file": {
      "type": "string"
    },
    "counts": {
      "type": "object"
    },
    "applicability_priorities": {
      "type": "object"
    },
    "constraint_types": {
      "type": "array"
    },
    "review_statuses": {
      "type": "array"
    },
    "requirement_statuses": {
      "type": "array"
    },
    "conflict_policy": {
      "type": "object"
    },
    "decision_policy": {
      "type": "object"
    },
    "governance": {
      "type": "object"
    }
