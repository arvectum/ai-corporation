{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arvectum.com/schemas/categories/electrical/detailed_profile_fragment.schema.json",
  "title": "ARV-067D detailed profile fragment",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "fragment_id",
    "version",
    "profiles"
  ],
  "properties": {
    "fragment_id": {
      "type": "string",
      "pattern": "^ARV-067D-[A-Z0-9-]+$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "profiles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title_ru",
          "target_category_id",
          "category_scope",
          "domain",
          "lifecycle_status",
          "aliases",
          "canonical_marks",
          "attributes",
          "normative_candidates",
          "source_basis",
          "fixture_minimum",
          "human_review_required",
          "production_active",
          "provenance"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]+$"
          },
          "title_ru": {
            "type": "string",
            "minLength": 5
          },
          "target_category_id": {
            "type": "string",
            "pattern": "^electrical(?:\\.[a-z][a-z0-9_]*){2,3}$"
          },
          "category_scope": {
            "enum": [
              "subcategory",
              "family"
            ]
          },
          "domain": {
            "enum": [
              "cable_accessories",
              "protection_switching",
              "lines_insulation",
              "low_voltage_controls"
            ]
          },
          "lifecycle_status": {
            "const": "fixtures_ready"
          },
          "aliases": {
            "type": "array",
            "minItems": 3,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 2
            }
          },
          "canonical_marks": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "attributes": {
            "type": "array",
            "minItems": 6,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "requirement",
                "critical",
                "comparator",
                "mismatch_reason_code",
                "comparator_basis"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]+$"
                },
                "requirement": {
                  "enum": [
                    "required",
                    "optional"
                  ]
                },
                "critical": {
                  "type": "boolean"
                },
                "comparator": {
                  "enum": [
                    "exact",
                    "minimum",
                    "maximum",
                    "contains",
                    "range_overlap"
                  ]
                },
                "mismatch_reason_code": {
                  "type": "string",
                  "pattern": "^[A-Z][A-Z0-9_]+$"
                },
                "comparator_basis": {
                  "enum": [
                    "canonical_default",
                    "profile_requirement_semantics"
                  ]
                }
              }
            }
          },
          "normative_candidates": {
            "type": "array",
            "minItems": 2,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 3
            }
          },
          "source_basis": {
            "type": "array",
            "minItems": 3,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "source_id",
                "role",
                "status"
              ],
              "properties": {
                "source_id": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]+$"
                },
                "role": {
                  "type": "string",
                  "minLength": 5
                },
                "status": {
                  "enum": [
                    "source_verified",
                    "metadata_candidate"
                  ]
                }
              }
            }
          },
          "fixture_minimum": {
            "type": "integer",
            "minimum": 12
          },
          "human_review_required": {
            "const": true
          },
          "production_active": {
            "const": false
          },
          "provenance": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source_asset",
              "review_status",
              "basis"
            ],
            "properties": {
              "source_asset": {
                "const": "ARV-067D"
              },
              "review_status": {
                "const": "human_review_required"
              },
              "basis": {
                "const": "engineering_profile_contract"
              }
            }
          }
        }
      }
    }
  }
}
