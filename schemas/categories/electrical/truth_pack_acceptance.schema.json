{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "acceptance_registry_id",
    "version",
    "status",
    "policy_ref",
    "machine_generator_actor_id",
    "profiles",
    "summary",
    "governance"
  ],
  "properties": {
    "acceptance_registry_id": {"const": "ARV-067H-TRUTH-PACK-INDEPENDENT-ACCEPTANCE"},
    "version": {"type": "string"},
    "status": {"enum": ["pending_independent_acceptance", "partially_accepted", "accepted", "rejected"]},
    "policy_ref": {"type": "string"},
    "machine_generator_actor_id": {"type": "string"},
    "profiles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "profile_id",
          "acceptance_status",
          "primary_annotator_id",
          "acceptance_annotator_id",
          "accepted_at",
          "acceptance_hash",
          "audited_item_count",
          "disagreement_rate",
          "rationale"
        ],
        "properties": {
          "profile_id": {"type": "string"},
          "acceptance_status": {"enum": ["pending", "accepted", "rejected"]},
          "primary_annotator_id": {"type": ["string", "null"]},
          "acceptance_annotator_id": {"type": ["string", "null"]},
          "accepted_at": {"type": ["string", "null"]},
          "acceptance_hash": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
          "audited_item_count": {"type": "integer", "minimum": 0},
          "disagreement_rate": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
          "rationale": {"type": "string", "minLength": 1}
        }
      }
    },
    "summary": {"type": "object"},
    "governance": {"type": "object"}
  }
}
