{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arvectum.com/schemas/categories/electrical/wave1_category_bindings.schema.json",
  "title": "ARV-067D category profile binding overlay",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "binding_id",
    "version",
    "base_tree_version",
    "overlay_semantics",
    "bindings",
    "governance"
  ],
  "properties": {
    "binding_id": {
      "const": "ARV-067D-WAVE1-CATEGORY-BINDINGS"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "base_tree_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "overlay_semantics": {
      "type": "string",
      "minLength": 50
    },
    "bindings": {
      "type": "array",
      "minItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "category_id",
          "base_lifecycle_status",
          "effective_lifecycle_status",
          "profile_refs",
          "additional_routing_aliases",
          "effective_attribute_refs",
          "human_review_gate",
          "production_active"
        ],
        "properties": {
          "category_id": {
            "type": "string",
            "pattern": "^electrical(?:\\.[a-z][a-z0-9_]*){2,3}$"
          },
          "base_lifecycle_status": {
            "const": "taxonomy_only"
          },
          "effective_lifecycle_status": {
            "const": "fixtures_ready"
          },
          "profile_refs": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]+$"
            }
          },
          "additional_routing_aliases": {
            "type": "array",
            "minItems": 3,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 2
            }
          },
          "effective_attribute_refs": {
            "type": "array",
            "minItems": 6,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]+$"
            }
          },
          "human_review_gate": {
            "const": true
          },
          "production_active": {
            "const": false
          }
        }
      }
    },
    "governance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "base_tree_is_immutable_snapshot",
        "effective_status_is_offline_only",
        "family_bindings_require_profile_discriminator",
        "human_review_required",
        "production_runtime_not_wired"
      ],
      "properties": {
        "base_tree_is_immutable_snapshot": {
          "const": true
        },
        "effective_status_is_offline_only": {
          "const": true
        },
        "family_bindings_require_profile_discriminator": {
          "const": true
        },
        "human_review_required": {
          "const": true
        },
        "production_runtime_not_wired": {
          "const": true
        }
      }
    }
  }
}
