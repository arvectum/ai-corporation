{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arvectum.com/schemas/categories/electrical/category_tree_fragment.schema.json",
  "title": "ARV-067B electrical category tree node fragment",
  "type": "object",
  "additionalProperties": false,
  "required": ["fragment_id", "version", "nodes"],
  "properties": {
    "fragment_id": {"type": "string", "pattern": "^ARV-067B-[A-Z0-9-]+$"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["category_id", "parent_id", "level", "path", "node_kind", "registry", "title_ru", "lifecycle_status", "detailed_profile_refs", "routing", "attributes", "provenance"],
        "properties": {
          "category_id": {"type": "string", "pattern": "^electrical(?:\\.[a-z][a-z0-9_]*){0,3}$"},
          "parent_id": {"anyOf": [{"type": "null"}, {"type": "string", "pattern": "^electrical(?:\\.[a-z][a-z0-9_]*){0,2}$"}]},
          "level": {"type": "integer", "minimum": 0, "maximum": 3},
          "path": {"type": "array", "minItems": 1, "maxItems": 4, "uniqueItems": true, "items": {"type": "string", "pattern": "^electrical(?:\\.[a-z][a-z0-9_]*){0,3}$"}},
          "node_kind": {"enum": ["root", "registry", "family", "subcategory"]},
          "registry": {"enum": ["none", "primary", "secondary"]},
          "title_ru": {"type": "string", "minLength": 2},
          "lifecycle_status": {"enum": ["taxonomy_only", "profile_draft", "source_verified", "fixtures_ready", "benchmark_passed", "shadow_runtime", "operator_approved", "production_active", "deprecated"]},
          "detailed_profile_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]+$"}},
          "routing": {
            "type": "object",
            "additionalProperties": false,
            "required": ["aliases", "priority", "block_auto_route", "review_if_only_match"],
            "properties": {
              "aliases": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 2}},
              "priority": {"type": "integer", "minimum": 0, "maximum": 100},
              "block_auto_route": {"type": "boolean"},
              "review_if_only_match": {"type": "boolean"}
            }
          },
          "attributes": {
            "type": "object",
            "additionalProperties": false,
            "required": ["inherit_parent", "local_refs", "overrides"],
            "properties": {
              "inherit_parent": {"type": "boolean"},
              "local_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]+$"}},
              "overrides": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["source_attribute_id", "replacement_attribute_id", "reason"],
                  "properties": {
                    "source_attribute_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]+$"},
                    "replacement_attribute_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]+$"},
                    "reason": {"type": "string", "minLength": 20}
                  }
                }
              }
            }
          },
          "provenance": {
            "type": "object",
            "additionalProperties": false,
            "required": ["source_asset", "source_kind"],
            "properties": {
              "source_asset": {"enum": ["category_tree.v1.yaml", "nomenclature.v1.yaml"]},
              "source_kind": {"enum": ["structural_root", "registry_group", "section_mapping", "subcategory_mapping"]},
              "source_section_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]+$"},
              "source_label": {"type": "string", "minLength": 2}
            }
          }
        }
      }
    }
  }
}
