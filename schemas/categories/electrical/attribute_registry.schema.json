{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arvectum.com/schemas/categories/electrical/attribute_registry.schema.json",
  "title": "ARV-067A electrical attribute registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "registry_id",
    "version",
    "status",
    "locale",
    "runtime_import",
    "purpose",
    "source_assets",
    "profile_id_aliases",
    "units",
    "comparators",
    "value_sets",
    "attributes",
    "governance"
  ],
  "properties": {
    "registry_id": {
      "const": "ARV-067A-ELECTRICAL-ATTRIBUTE-REGISTRY"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "status": {
      "const": "research_asset"
    },
    "locale": {
      "const": "ru-RU"
    },
    "runtime_import": {
      "const": false
    },
    "purpose": {
      "type": "string",
      "minLength": 60
    },
    "source_assets": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "path", "role"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]+$"},
          "path": {"type": "string", "minLength": 5},
          "role": {"type": "string", "minLength": 5}
        }
      }
    },
    "profile_id_aliases": {
      "type": "object",
      "additionalProperties": {"type": "string", "pattern": "^[a-z][a-z0-9_]+$"}
    },
    "units": {
      "type": "array",
      "minItems": 15,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title_ru", "symbol", "dimension", "base_unit", "factor_to_base"],
        "properties": {
          "id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]*$"},
          "title_ru": {"type": "string", "minLength": 2},
          "symbol": {"type": "string"},
          "dimension": {"type": "string", "minLength": 2},
          "base_unit": {"type": "string", "minLength": 1},
          "factor_to_base": {"type": "number", "exclusiveMinimum": 0},
          "aliases": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "comparators": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title_ru", "description", "allowed_value_types"],
        "properties": {
          "id": {"enum": ["exact", "minimum", "maximum", "contains", "range_overlap"]},
          "title_ru": {"type": "string", "minLength": 3},
          "description": {"type": "string", "minLength": 10},
          "allowed_value_types": {
            "type": "array",
            "minItems": 1,
            "items": {"enum": ["number", "integer", "enum", "boolean", "text", "set", "range"]}
          }
        }
      }
    },
    "value_sets": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source", "values"],
        "properties": {
          "source": {"type": "string"},
          "values": {"type": "array", "minItems": 1, "items": {"type": "string"}}
        }
      }
    },
    "attributes": {
      "type": "array",
      "minItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id", "title_ru", "value_type", "default_comparator", "semantic_role",
          "maturity", "aliases", "provenance"
        ],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]+$"},
          "title_ru": {"type": "string", "minLength": 3},
          "value_type": {"enum": ["number", "integer", "enum", "boolean", "text", "set", "range"]},
          "canonical_unit": {"type": "string"},
          "default_comparator": {"enum": ["exact", "minimum", "maximum", "contains", "range_overlap"]},
          "semantic_role": {
            "enum": [
              "identity", "capability", "constraint", "compatibility", "applicability",
              "construction", "environment", "configuration", "safety", "efficiency",
              "reliability", "lifecycle", "evidence"
            ]
          },
          "maturity": {"enum": ["verified_detailed_profile", "provisional_taxonomy", "deprecated"]},
          "aliases": {"type": "array", "items": {"type": "string"}},
          "value_set_ref": {"type": "string"},
          "allowed_values": {"type": "array", "items": {"type": "string"}},
          "notes": {"type": "string"},
          "provenance": {
            "type": "object",
            "additionalProperties": false,
            "required": ["source_asset", "basis"],
            "properties": {
              "source_asset": {"enum": ["electrical.v1.yaml", "nomenclature.v1.yaml"]},
              "basis": {"enum": ["explicit_attribute_definition", "discriminator_id_and_engineering_inference"]}
            }
          }
        }
      }
    },
    "governance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provisional_attributes_are_not_match_rules",
        "role_specific_voltage_attributes_must_not_be_auto_merged",
        "unit_conversion_requires_same_dimension",
        "human_review_required_before_profile_activation",
        "full_text_normative_sources_not_stored"
      ],
      "properties": {
        "provisional_attributes_are_not_match_rules": {"const": true},
        "role_specific_voltage_attributes_must_not_be_auto_merged": {"const": true},
        "unit_conversion_requires_same_dimension": {"const": true},
        "human_review_required_before_profile_activation": {"const": true},
        "full_text_normative_sources_not_stored": {"const": true}
      }
    }
  }
}
