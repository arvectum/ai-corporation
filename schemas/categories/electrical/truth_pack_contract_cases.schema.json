{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["suite_id", "version", "base_benchmark_id", "cases"],
  "properties": {
    "suite_id": {"const": "ARV-067H-TRUTH-PACK-CONTRACT-CASES"},
    "version": {"type": "string"},
    "base_benchmark_id": {"type": "string"},
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "mutation", "target_id", "expected_error_codes"],
        "properties": {
          "id": {"type": "string"},
          "mutation": {"type": "string"},
          "target_id": {"type": ["string", "null"]},
          "expected_error_codes": {
            "type": "array",
            "items": {"type": "string"}
          }
        }
      }
    }
  }
}
